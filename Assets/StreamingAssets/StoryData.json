      "Audio": false,
      "EndPoint": false,
      "TargetImageName": "Bg_Morning",
      "TargetAudio": null,
      "TargetMusic": "평화로운브금"
    },
    {
      "Story_ID": 10010,
      "Speaker": "시스템",
      "Dialogue": "하지만 베틀이 스스로 움직이며 콩쥐를 위협하기 시작했다.",
      "Is_Image": true,
      "Audio": false,
      "EndPoint": false,
      "TargetImageName": null,
      "TargetAudio": "베틀소리",
      "TargetMusic": "긴박한브금"
    },
    {
      "Story_ID": 10011,
      "Speaker": "콩쥐",
      "Dialogue": "내 앞을 막는 건 그게 무엇이든 다 부숴버릴 거야.",
