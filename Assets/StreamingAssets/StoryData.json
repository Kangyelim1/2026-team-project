 [
    {
      "Story_ID": 10001,
      "Speaker": "시스템",
      "Dialogue": "일찍이 어머니를 여의고 계모와 팥쥐에게 구박받으며 자란 콩쥐.",
      "Is_Image": true,
      "Audio": false,
      "EndPoint": false,
      "TargetImageName": "Bg_Yard",
      "TargetAudio": null,
      "TargetMusic": "평화로운브금"
    },
    {
      "Story_ID": 10002,
      "Speaker": "시스템",
      "Dialogue": "어느 날, 눈앞에 피투성이가 된 미래의 자신이 나타나 속삭였다.",
      "Is_Image": false,
      "Audio": false,
      "EndPoint": false,
      "TargetImageName": null,
      "TargetAudio": "심장박동소리",
      "TargetMusic": "무서운브금"
    },
    {
      "Story_ID": 10003,
      "Speaker": "미래의 콩쥐",
      "Dialogue": "...이대로 가다간, 연못에 빠져 죽게 될 거야. 살고 싶다면 전부 베어버려.",
      "Is_Image": true,
      "Audio": false,
      "EndPoint": false,
      "TargetImageName": "FutureKongjwi_Sad",
      "TargetAudio": null,
      "TargetMusic": null
    },
    {
      "Story_ID": 10004,
      "Speaker": "콩쥐",
      "Dialogue": "내가... 내가 죽는다고? 안 돼, 살아야 해...",
      "Is_Image": true,
      "Audio": false,
      "EndPoint": false,
      "TargetImageName": "Kongjwi_Normal",
      "TargetAudio": null,
      "TargetMusic": "긴박한브금"
    },
    {
      "Story_ID": 10005,
      "Speaker": "계모",
      "Dialogue": "이년아! 멍하니 서서 뭐 해! 당장 이 마당의 벼를 다 베어놓지 못할까!",
      "Is_Image": true,
      "Audio": false,
      "EndPoint": false,
      "TargetImageName": "StepMother_Angry",
      "TargetAudio": "호통소리",
      "TargetMusic": null
    },
    {
      "Story_ID": 10006,
      "Speaker": "콩쥐",
      "Dialogue": "네, 네... 어머니. 금방 다 베겠습니다.",
      "Is_Image": true,
      "Audio": false,
      "EndPoint": false,
      "TargetImageName": "Kongjwi_Normal",
      "TargetAudio": null,
      "TargetMusic": null
    },
    {
      "Story_ID": 10007,
      "Speaker": "콩쥐",
      "Dialogue": "...맞아. 낫으로 다 베어버리면, 내가 살 수 있어.",
      "Is_Image": true,
      "Audio": false,
      "EndPoint": false,
      "TargetImageName": "Kongjwi_CrazySmile",
      "TargetAudio": "낫휘두르는소리",
      "TargetMusic": null
