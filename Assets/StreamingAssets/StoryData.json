      "Audio": false,
      "EndPoint": false,
      "TargetImageName": "StepMother_Normal",
      "TargetAudio": null,
      "TargetMusic": "평화로운브금"
    },
    {
      "Story_ID": 10021,
      "Speaker": "콩쥐",
      "Dialogue": "팥쥐요? 아... 제가 아까 조용하게 만들어 줬어요. 영원히요.",
