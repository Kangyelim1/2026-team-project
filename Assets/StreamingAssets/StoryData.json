      "Audio": false,
      "EndPoint": false,
      "TargetImageName": "Patjwi_Normal",
      "TargetAudio": null,
      "TargetMusic": "평화로운브금"
    },
    {
      "Story_ID": 10014,
      "Speaker": "콩쥐",
      "Dialogue": "팥쥐야. 늘 네가 내 옷을 뺏고, 나를 때렸지. 이제 네 차례야.",
      "Is_Image": true,
      "Audio": false,
      "EndPoint": false,
      "TargetImageName": "Kongjwi_CrazySmile",
      "TargetAudio": null,
      "TargetMusic": "스산한브금"
    },
    {
      "Story_ID": 10015,
      "Speaker": "팥쥐",
      "Dialogue": "꺄아아악! 이 미친년이 돌았나! 가까이 오지 마!",
      "Is_Image": true,
      "Audio": false,
      "EndPoint": false,
      "TargetImageName": "Patjwi_Surprise",
      "TargetAudio": "발걸음소리",
      "TargetMusic": null
    },
    {
      "Story_ID": 10016,
      "Speaker": "콩쥐",
      "Dialogue": "걱정 마. 아프지 않게, 단번에 끝내줄게.",
