  storys:
  - Story_ID: 10001
    Speaker: "\uC2DC\uC2A4\uD15C"
    Dialogue: "\uC77C\uCC0D\uC774 \uC5B4\uBA38\uB2C8\uB97C \uC5EC\uC758\uACE0 \uACC4\uBAA8\uC640
      \uD325\uC950\uC5D0\uAC8C \uAD6C\uBC15\uBC1B\uC73C\uBA70 \uC790\uB780 \uCF69\uC950."
    Is_Image: 1
    Audio: 0
    EndPoint: 0
    TargetImageName: Bg_Yard
    TargetAudio: 
    TargetMusic: "\uD3C9\uD654\uB85C\uC6B4\uBE0C\uAE08"
  - Story_ID: 10002
    Speaker: "\uC2DC\uC2A4\uD15C"
    Dialogue: "\uC5B4\uB290 \uB0A0, \uB208\uC55E\uC5D0 \uD53C\uD22C\uC131\uC774\uAC00
      \uB41C \uBBF8\uB798\uC758 \uC790\uC2E0\uC774 \uB098\uD0C0\uB098 \uC18D\uC0AD\uC600\uB2E4."
    Is_Image: 0
    Audio: 0
    EndPoint: 0
    TargetImageName: 
    TargetAudio: "\uC2EC\uC7A5\uBC15\uB3D9\uC18C\uB9AC"
    TargetMusic: "\uBB34\uC11C\uC6B4\uBE0C\uAE08"
  - Story_ID: 10003
    Speaker: "\uBBF8\uB798\uC758 \uCF69\uC950"
    Dialogue: "...\uC774\uB300\uB85C \uAC00\uB2E4\uAC04, \uC5F0\uBABB\uC5D0 \uBE60\uC838
      \uC8FD\uAC8C \uB420 \uAC70\uC57C. \uC0B4\uACE0 \uC2F6\uB2E4\uBA74 \uC804\uBD80
      \uBCA0\uC5B4\uBC84\uB824."
    Is_Image: 1
    Audio: 0
    EndPoint: 0
    TargetImageName: FutureKongjwi_Sad
    TargetAudio: 
    TargetMusic: 
  - Story_ID: 10004
    Speaker: "\uCF69\uC950"
    Dialogue: "\uB0B4\uAC00... \uB0B4\uAC00 \uC8FD\uB294\uB2E4\uACE0? \uC548 \uB3FC,
      \uC0B4\uC544\uC57C \uD574..."
    Is_Image: 1
    Audio: 0
    EndPoint: 0
    TargetImageName: Kongjwi_Normal
    TargetAudio: 
    TargetMusic: "\uAE34\uBC15\uD55C\uBE0C\uAE08"
  - Story_ID: 10005
    Speaker: "\uACC4\uBAA8"
    Dialogue: "\uC774\uB144\uC544! \uBA4D\uD558\uB2C8 \uC11C\uC11C \uBB50 \uD574!
      \uB2F9\uC7A5 \uC774 \uB9C8\uB2F9\uC758 \uBCBC\uB97C \uB2E4 \uBCA0\uC5B4\uB193\uC9C0
      \uBABB\uD560\uAE4C!"
    Is_Image: 1
    Audio: 0
    EndPoint: 0
    TargetImageName: StepMother_Angry
    TargetAudio: "\uD638\uD1B5\uC18C\uB9AC"
    TargetMusic: 
  - Story_ID: 10006
    Speaker: "\uCF69\uC950"
    Dialogue: "\uB124, \uB124... \uC5B4\uBA38\uB2C8. \uAE08\uBC29 \uB2E4 \uBCA0\uACA0\uC2B5\uB2C8\uB2E4."
    Is_Image: 1
    Audio: 0
    EndPoint: 0
    TargetImageName: Kongjwi_Normal
    TargetAudio: 
    TargetMusic: 
  - Story_ID: 10007
    Speaker: "\uCF69\uC950"
    Dialogue: "...\uB9DE\uC544. \uB0AB\uC73C\uB85C \uB2E4 \uBCA0\uC5B4\uBC84\uB9AC\uBA74,
